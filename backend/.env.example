# Copy to .env and fill in. Never commit the real .env.

# --- Required (server refuses to start without these) ---
MONGO_URI=mongodb://localhost:27017/writask
JWT_SECRET=change-me-to-a-long-random-string

# --- Server ---
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3001
API_PUBLIC_URL=

# Comma-separated browser origins allowed by CORS / socket.io.
# REQUIRED in production, e.g. https://app.example.com
CORS_ORIGINS=http://localhost:3001

# --- Email (SMTP) ---
SMTP_EMAIL=
SMTP_PASSWORD=
SMTP_PORT=587
SUPPORT_EMAIL=

# --- Google sign-in ---
GOOGLE_CLIENT_ID=

# --- Optional ---
REDIS_URL=
# Production only: Bearer token required to scrape /metrics (endpoint is off when unset)
METRICS_TOKEN=
# Production only: set to true to expose /api/docs
ENABLE_API_DOCS=false
WEEKLY_REPORT_ENABLED=
WEEKLY_REPORT_CRON=
WEEKLY_REPORT_TZ=
